#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { runtimePackageRoot } from '../src/index.mjs';

const commandPath = path.join(runtimePackageRoot, 'harness/installer/commands/harness.mjs');
const result = spawnSync(process.execPath, [commandPath, ...process.argv.slice(2)], {
  cwd: process.cwd(),
  env: {
    ...process.env,
    HARNESS_SOURCE_ROOT: runtimePackageRoot
  },
  stdio: 'inherit'
});

if (result.error) {
  throw result.error;
}

process.exit(result.status ?? 1);
