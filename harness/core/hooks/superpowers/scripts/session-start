#!/usr/bin/env bash
# Emits compact superpowers context for session start.
# Usage: session-start [TARGET]
# TARGET: codex (default), copilot, cursor, or claude-code.
#         cursor uses additional_context payload; others use hookSpecificOutput.
set -euo pipefail

target="${1:-codex}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
script_name="$(basename "${BASH_SOURCE[0]}")"
script_path="$script_dir/$script_name"

source_runtime_hook_evidence_helper() {
  local helper
  for helper in \
    "$script_dir/runtime-hook-evidence.sh" \
    "$script_dir/../../runtime-hook-evidence.sh"; do
    if [ -f "$helper" ]; then
      # shellcheck source=/dev/null
      . "$helper"
      return 0
    fi
  done

  return 1
}

source_runtime_hook_evidence_helper || true

if declare -F harness_resolve_project_root >/dev/null 2>&1; then
  root="$(harness_resolve_project_root)"
else
  root="${HARNESS_PROJECT_ROOT:-$(pwd)}"
fi

json_escape() {
  node -e 'let input = ""; process.stdin.setEncoding("utf8"); process.stdin.on("data", chunk => { input += chunk; }); process.stdin.on("end", () => { process.stdout.write(JSON.stringify(input)); });'
}

context="$(cat <<'EOF'
<EXTREMELY_IMPORTANT>
You have superpowers.

Before acting, check the projected skill relevant to the task.
Keep simple tasks lightweight.
For complex tasks, use the right process skill and sync durable state back to planning/active/<task-id>/.
Before each substantive goal round or continuation phase, restore the active planning files, reclassify the round, and keep quick rounds lightweight.
</EXTREMELY_IMPORTANT>
EOF
)"
escaped="$(printf '%s' "$context" | json_escape)"

case "$target" in
  cursor)
    printf '{"additional_context":%s}\n' "$escaped"
    ;;
  *)
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":%s}}\n' "$escaped"
    ;;
esac

if declare -F harness_record_runtime_hook_evidence >/dev/null 2>&1; then
  harness_record_runtime_hook_evidence \
    "$target" \
    "superpowers" \
    "SessionStart" \
    "$root" \
    "$(pwd)" \
    "$script_name" \
    "$script_path" || true
fi
